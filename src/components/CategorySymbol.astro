	action: '<rect x="2" y="8" width="20" height="10" rx="5"/><path d="M7 11v4M5 13h4"/><circle cx="16" cy="11.5" r="1"/><circle cx="18.5" cy="14" r="1"/>',
	puzzle: '<path d="M8.5 4 H4 V8.5 A2.5 2.5 0 0 1 4 13.5 V20 H10.5 A2.5 2.5 0 0 0 15.5 20 H20 V13.5 A2.5 2.5 0 0 1 20 8.5 V4 H13.5 A2.5 2.5 0 0 1 8.5 4 Z"/>',
	adventure: '<path d="M3 8l6-3 6 3 6-3v11l-6 3-6-3-6 3z"/><path d="M9 5v11M15 8v11"/>',
	strategy: '<circle cx="12" cy="8" r="5"/><path d="M9 12l-2 9 5-3 5 3-2-9"/>',
	sports: '<circle cx="12" cy="12" r="9"/><path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5L18 18M18 6l-2.5 2.5M8.5 15.5L6 18"/>',
	arcade: '<path d="M12 3v9"/><circle cx="12" cy="4.5" r="1.5"/><path d="M6 21l3-9h6l3 9"/><path d="M5 21h14"/>',
	shooter: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="0.5" fill="currentColor"/>',
	simulation: '<path d="M12 3l1.2 2.6 2.8.3-2 2 .5 2.8L12 9.3 9.5 10.7l.5-2.8-2-2 2.8-.3z"/><path d="M6.5 13a5.5 5.5 0 0 0 11 0"/><path d="M4 13h1.5M18.5 13H20"/>',
	casual: '<rect x="3" y="3" width="8" height="8" rx="2"/><rect x="13" y="13" width="8" height="8" rx="2"/><circle cx="6" cy="6" r="0.6" fill="currentColor" stroke="none"/><circle cx="8" cy="8" r="0.6" fill="currentColor" stroke="none"/><circle cx="16" cy="16" r="0.6" fill="currentColor" stroke="none"/><circle cx="18" cy="18" r="0.6" fill="currentColor" stroke="none"/><circle cx="16" cy="18" r="0.6" fill="currentColor" stroke="none"/><circle cx="18" cy="16" r="0.6" fill="currentColor" stroke="none"/>',
	rpg: '<path d="M14.5 3.5l6 6-2 2-6-6z"/><path d="M18.5 5.5L21 3M3 21l6-6M9 15l-3 3"/><path d="M4 20l1-3 2.5 2.5z"/>',
	horror: '<path d="M6 10a6 6 0 0 1 12 0v7l-1.5-1.5L15 18l-1.5-1.5L12 18l-1.5-1.5L9 18l-1.5-1.5L6 17z"/><circle cx="9.5" cy="10" r="0.6" fill="currentColor" stroke="none"/><circle cx="14.5" cy="10" r="0.6" fill="currentColor" stroke="none"/>',
	card: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M12 8v4l2.5 1.5"/>',
	educational: '<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H12v16H6.5A2.5 2.5 0 0 0 4 21.5z"/><path d="M20 5.5A2.5 2.5 0 0 0 17.5 3H12v16h5.5a2.5 2.5 0 0 1 2.5 2.5z"/>',
	music: '<path d="M9 18V5l10-2v13"/><circle cx="6.5" cy="18" r="2.5"/><circle cx="16.5" cy="16" r="2.5"/>',
	board: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18M15 3v18"/>',
	multiplayer: '<circle cx="8" cy="8" r="3"/><path d="M2 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.5"/><path d="M14.5 20c.2-2.8 2.3-5 5-5"/>',
	other: '<path d="M12 3l2.5 6.5H21l-5.2 4 2 6.5L12 16l-5.8 4 2-6.5-5.2-4h6.5z"/>',
};

interface Props {
	symbol?: string;
}

const { symbol } = Astro.props;
const inner = (symbol && ICONS[symbol]) || ICONS.other;
---

<Fragment set:html={`<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">${inner}</svg>`} />
