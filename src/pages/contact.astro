---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Contact"
	description="Get in touch with Ukrainian Games — questions, developer inquiries, or DMCA reports."
	path="/contact/"
>
	<main class="ug-container ug-home">
		<div class="ug-home__section" style="max-width:42rem;">
			<h1>Contact</h1>
			<p class="ug-description-text">Have a question about a listing, a developer inquiry, or a DMCA report? Reach out and we'll get back to you as soon as we can.</p>
			<p class="ug-description-text">Email: <a href="mailto:support@ukrainiangames.com">support@ukrainiangames.com</a></p>
		</div>
	</main>
</Layout>
