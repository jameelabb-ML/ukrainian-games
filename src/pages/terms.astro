---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Terms of Use"
	description="Terms of use for the Ukrainian Games website."
	path="/terms/"
>
	<main class="ug-container ug-home">
		<div class="ug-home__section" style="max-width:42rem;">
			<h1>Terms of Use</h1>
			<p class="ug-description-text">By using this site, you agree to the following terms.</p>
			<p class="ug-description-text">Ukrainian Games is an independent catalog for discovering Android games. Game listings, ratings, and download links are provided for informational purposes; we are not the developer or publisher of the games listed unless stated otherwise.</p>
			<p class="ug-description-text">You agree to use this site for lawful, personal purposes only, and not to submit false, abusive, or infringing reviews or content.</p>
			<p class="ug-description-text">Downloads are provided as-is, without warranty of any kind. We are not responsible for how third-party applications behave once installed on your device.</p>
			<p class="ug-description-text">We may update these terms from time to time. Continued use of the site after changes means you accept the updated terms.</p>
			<p class="ug-description-text">Questions? Reach out via the <a href="/contact/">Contact page</a>.</p>
		</div>
	</main>
</Layout>
