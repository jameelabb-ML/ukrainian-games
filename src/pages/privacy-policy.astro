---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Privacy Policy"
	description="How Ukrainian Games handles information when you visit this site."
	path="/privacy-policy/"
>
	<main class="ug-container ug-home">
		<div class="ug-home__section" style="max-width:42rem;">
			<h1>Privacy Policy</h1>
			<p class="ug-description-text">This Privacy Policy explains how Ukrainian Games handles information when you visit this site.</p>
			<p class="ug-description-text">We do not require account creation to browse or download games. If you submit a review, we store the name you provide, your rating, and your review text so it can be displayed publicly once approved — we do not verify or require an email address for reviews.</p>
			<p class="ug-description-text">Our hosting provider may log standard technical information (such as IP address and browser type) for security and performance purposes, as is standard for most websites.</p>
			<p class="ug-description-text">If you have questions about this policy or want a review removed, please get in touch via the <a href="/contact/">Contact page</a>.</p>
		</div>
	</main>
</Layout>
